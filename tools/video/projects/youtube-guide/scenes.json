        { "wait": 2.9 },
        { "highlight": "#nav-subs", "duration": 2.6 },
        { "wait": 4.7 },
        { "highlight": "#nav-history", "duration": 1.8 },
        { "wait": 1.6 },
        { "highlight": "#nav-later", "duration": 2.0 },
        { "wait": 2.9 },
        { "highlight": "#chips", "duration": 2.6 },
        { "wait": 5.4 },
        { "click": "#chip-cook", "optional": true },
        { "wait": 2.5 },
        { "click": "#chip-all", "optional": true },
        { "scroll": 660, "duration": 2.2 },
        { "wait": 1.6 },
        { "scroll": 900, "duration": 2.0 },

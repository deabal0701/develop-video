        { "highlight": "#header", "duration": 2.2 },
        { "wait": 1.3 },
        { "highlight": "#sidebar", "duration": 2.2 },
        { "wait": 1.3 },
        { "highlight": "#main", "duration": 2.4 },
        { "wait": 4.5 },
        { "highlight": "#nav-home", "duration": 1.4 },

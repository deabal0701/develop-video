# develop-video — API 키. 이 파일을 .env 로 복사해서 값을 채운다.
#
#   cp .env.sample .env        # (PowerShell) Copy-Item .env.sample .env
#
# .env 는 커밋하지 않는다(.gitignore). .env.sample 만 커밋해 "무슨 키가 필요한지"를 남긴다.
#
# 읽는 순서: 영상 작업 폴더(tools/video/.env) → 상위 폴더 → 저장소 루트/.env → 실행 위치.
# 가까운 파일이 이기고, 셸에 이미 있는 환경변수가 파일보다 우선한다.
# 값을 비워 두면 "설정 안 함"으로 본다 — 이 파일을 그대로 복사해 둬도 안전하다.

# ── TTS ───────────────────────────────────────────────────────────────────────
# 기본 제공자는 edge(edge-tts)이고 키가 필요 없다. 아래 두 줄은 --provider azure 로
# 정식 Azure Speech 를 쓸 때만 필요하다.
#
# 키가 없거나 만료·결제 중단·쿼터 소진이면 자동으로 edge 로 내려간다(키 불필요, 같은 뉴럴 음성).
# 즉 이 칸이 비어 있어도 영상은 나온다. 폴백 없이 바로 실패시키려면 scenes.json 의
# voice 에 "strict": true 를 넣는다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
